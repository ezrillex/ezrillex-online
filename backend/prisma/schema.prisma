// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./short.db"
}

model ShortenedLink {
  sauce String @id
  url String  @unique
  // indexes not supported with sqlite :c too lazy to use mysql rn
}